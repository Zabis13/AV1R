#!/bin/sh

# Windows configure for AV1R
# Checks for FFmpeg and Vulkan SDK via environment variables

FFMPEG_CPPFLAGS=""
FFMPEG_LIBS="-lavcodec -lavformat -lavutil -lswscale"
VULKAN_CPPFLAGS=""
VULKAN_LIBS=""

# FFmpeg via FFMPEG_DIR or Rtools
if [ -n "$FFMPEG_DIR" ]; then
  FFMPEG_CPPFLAGS="-I${FFMPEG_DIR}/include"
  FFMPEG_LIBS="-L${FFMPEG_DIR}/lib $FFMPEG_LIBS"
  echo "Found FFmpeg at: $FFMPEG_DIR"
else
  echo "Note: Set FFMPEG_DIR to FFmpeg installation path."
fi

# Vulkan SDK
if [ -n "$VULKAN_SDK" ]; then
  # Normalize the SDK path: convert Windows backslashes to forward slashes.
  # gcc/MinGW accept forward slashes, and this keeps the path safe for use in
  # the right-hand side of the sed substitutions below. Native backslashes
  # (e.g. C:\VulkanSDK\1.4.350.0) would be misread by sed as backreferences
  # (\1, \4, ...) -> "invalid reference \1 on 's' command's RHS".
  VULKAN_SDK_FWD=$(printf '%s' "$VULKAN_SDK" | tr '\\' '/')
  VULKAN_CPPFLAGS="-DAV1R_USE_VULKAN -DAV1R_VULKAN_VIDEO_AV1 -I${VULKAN_SDK_FWD}/Include"
  VULKAN_LIBS="-L${VULKAN_SDK_FWD}/Lib -lvulkan-1"
  echo "Found Vulkan SDK at: $VULKAN_SDK"
fi

sed \
  -e "s|@FFMPEG_CPPFLAGS@|$FFMPEG_CPPFLAGS|g" \
  -e "s|@FFMPEG_LIBS@|$FFMPEG_LIBS|g" \
  -e "s|@VULKAN_CPPFLAGS@|$VULKAN_CPPFLAGS|g" \
  -e "s|@VULKAN_LIBS@|$VULKAN_LIBS|g" \
  src/Makevars.win.in > src/Makevars.win
